#ifndef SCALAPACK_TYPES_H
#define SCALAPACK_TYPES_H 1

#include <stddef.h>
#include <stdint.h>

/*
 * Semantic integer types used internally by the C sources:
 * - ScaLAPACK_ApiInt matches the default Fortran INTEGER ABI.
 * - ScaLAPACK_BlasInt matches the configured BLAS integer ABI.
 * - ScaLAPACK_ByteCount is for byte sizes and allocation lengths.
 * - ScaLAPACK_Index32 / ScaLAPACK_Index64 are explicit fixed-width indices.
 * - ScaLAPACK_UWord32 is for IEEE bit-pattern inspection.
 */
#define SCALAPACK_FORTRAN_INT_BYTES @SCALAPACK_FORTRAN_INT_BYTES@
#define SCALAPACK_BLAS_INT_BYTES @SCALAPACK_EXPECT_BLAS_INT_BYTES@

typedef @SCALAPACK_API_INT_C_TYPE@ ScaLAPACK_ApiInt;
typedef @SCALAPACK_BLAS_INT_C_TYPE@ ScaLAPACK_BlasInt;
typedef @SCALAPACK_BLACS_BUFFER_SIZE_TYPE@ ScaLAPACK_BufLen;
typedef ScaLAPACK_BufLen ScaLAPACK_ByteCount;
typedef int32_t ScaLAPACK_Index32;
typedef int64_t ScaLAPACK_Index64;
typedef uint32_t ScaLAPACK_UWord32;

_Static_assert(sizeof(ScaLAPACK_ApiInt) == SCALAPACK_FORTRAN_INT_BYTES,
               "ScaLAPACK_ApiInt must match the configured Fortran INTEGER width.");
_Static_assert(sizeof(ScaLAPACK_BlasInt) == SCALAPACK_BLAS_INT_BYTES,
               "ScaLAPACK_BlasInt must match the configured BLAS integer width.");
_Static_assert(sizeof(ScaLAPACK_UWord32) == 4,
               "IEEE helpers need a 32-bit unsigned word type.");
_Static_assert(sizeof(ScaLAPACK_BufLen) <= sizeof(size_t),
               "ScaLAPACK_BufLen must fit within size_t.");

static inline int ScaLAPACK_Index64Mul(ScaLAPACK_Index64 left,
                                       ScaLAPACK_Index64 right,
                                       ScaLAPACK_Index64 *product)
{
    if (left < 0 || right < 0) return 0;
    if (left != 0 && right > INT64_MAX / left) return 0;
    *product = left * right;
    return 1;
}

static inline int ScaLAPACK_Index64Add(ScaLAPACK_Index64 left,
                                       ScaLAPACK_Index64 right,
                                       ScaLAPACK_Index64 *sum)
{
    if ((right > 0 && left > INT64_MAX - right) ||
        (right < 0 && left < INT64_MIN - right)) return 0;
    *sum = left + right;
    return 1;
}

static inline int ScaLAPACK_Index64ToSizeT(ScaLAPACK_Index64 value,
                                           size_t *result)
{
    if (value < 0) return 0;
    if ((uint64_t) value > (uint64_t) SIZE_MAX) return 0;
    *result = (size_t) value;
    return 1;
}

static inline int ScaLAPACK_Index64ToApiInt(ScaLAPACK_Index64 value,
                                            ScaLAPACK_ApiInt *result)
{
#if SCALAPACK_FORTRAN_INT_BYTES == 4
    if (value < INT32_MIN || value > INT32_MAX) return 0;
#elif SCALAPACK_FORTRAN_INT_BYTES == 8
    if (value < INT64_MIN || value > INT64_MAX) return 0;
#else
#error "Unsupported ScaLAPACK API integer width."
#endif
    *result = (ScaLAPACK_ApiInt) value;
    return 1;
}

#endif
